{
    "name": "vlossom",
    "description": "Vlossom UI components for Vue",
    "version": "2.0.2",
    "author": "vlossom",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vlossom-ui/vlossom.git",
        "directory": "packages/vlossom"
    },
    "bugs": {
        "url": "https://github.com/vlossom-ui/vlossom/issues"
    },
    "license": "MIT",
    "keywords": [
        "vlossom",
        "vue",
        "components",
        "ui framework",
        "component library"
    ],
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.playground.ts",
        "type-check": "vue-tsc --build",
        "build": "run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . && stylelint \"src/**/*.{css,scss}\"",
        "format": "prettier --write src/**/*.{js,ts,vue,json}",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "palette": "node scripts/generate-palette.js"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/vlossom.umd.js",
    "module": "./dist/vlossom.es.js",
    "unpkg": "./dist/vlossom.umd.js",
    "jsdelivr": "./dist/vlossom.umd.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/vlossom.es.js",
            "require": "./dist/vlossom.umd.js"
        },
        "./styles": {
            "types": "./dist/vlossom-styles.d.ts",
            "default": "./dist/vlossom.css"
        }
    },
    "dependencies": {
        "@lucide/vue": "^1.38.0",
        "@vueuse/core": "^14.4.0",
        "change-case": "^5.4.4",
        "nanoid": "^6.0.1",
        "radash": "^12.1.1",
        "vue": "^3.5.42",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.0",
        "@storybook/addon-a11y": "10.5.10",
        "@storybook/addon-docs": "10.5.10",
        "@storybook/builder-vite": "^10.5.10",
        "@storybook/vue3-vite": "10.5.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^24.13.3",
        "@types/sortablejs": "^1.15.9",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/language-core": "^3.3.11",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "culori": "^4.0.2",
        "eslint": "^10.9.1",
        "eslint-plugin-storybook": "10.5.10",
        "eslint-plugin-vue": "~10.10.0",
        "glob": "^13.0.6",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-run-all2": "^9.0.3",
        "prettier": "3.9.6",
        "prettier-plugin-classnames": "^0.10.4",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-merge": "^0.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass": "^1.103.1",
        "storybook": "10.5.10",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-value-no-unknown-custom-properties": "^6.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "unplugin-dts": "^1.0.3",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    }
}
