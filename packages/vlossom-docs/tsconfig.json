{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node", "vitepress/client"]
    },
    "include": [".vitepress/**/*.ts"]
}
